# Copy to .env for local development. Never commit a real .env file.

# --- Execution mode gating (spec §3 / §46 / §56) ---
# research  = analysis only, no orders can be placed
# paper     = simulated broker, no real money
# live      = real broker, real money — requires LIVE_TRADING_ENABLED=true AND explicit confirmation flow
TRADING_MODE=research
LIVE_TRADING_ENABLED=false

# --- Emergency stop (spec Sec46 / D039) ---
# BOOTSTRAP DEFAULT ONLY. The authoritative kill-switch state lives in the
# emergency_stop_events table and is flipped live over
# POST /admin/emergency-stop (admin:manage, reason required) - no restart,
# no edit to this file. This value is consulted if and only if that table
# is still empty, i.e. the stop has never been flipped on this database;
# after that, changing it here has no effect on the trade path.
EMERGENCY_STOP_ACTIVE=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trading_os:trading_os@localhost:5432/trading_os
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Auth ---
# No default is provided in code on purpose - the app refuses to start
# without this set. Generate your own for local dev, never reuse this one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-CHANGE-ME-8f3a1c9e2b7d4f6091a5e8c2d7b4f1a9
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Failed-login lockout (Phase 39 / D049) ---
# After this many CONSECUTIVE failed password attempts, an existing active
# account is locked for AUTH_LOCKOUT_DURATION_MINUTES - even a correct
# password is refused (423) until the lock expires. A successful login
# resets the counter. Set AUTH_MAX_FAILED_LOGIN_ATTEMPTS=0 to disable the
# lockout entirely; there is no unlock endpoint, so the duration is the
# only way out and should stay short.
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# --- Password reset (Phase 46 / D063) ---
# The flow works with NONE of these set. Defaults shown; uncomment to change.
#
# How long an issued reset link stays redeemable. Stamped onto the row at
# creation, so changing this never extends or revokes a link already sent.
# AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
#
# Reset tokens issuable per ACCOUNT per rolling hour, counted from the
# password_reset_tokens table itself (so it holds across workers). Tripping
# it does not change the response - POST /auth/password-reset/request always
# answers the same generic 200, or the limit would itself reveal which
# addresses are registered. 0 disables this layer.
# AUTH_PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
#
# Requests per client IP per hour, answered with 429. This is the layer that
# bounds a flood of addresses that do not exist. Honestly scoped: it is an
# in-process counter, so N workers means N times this number, and it resets
# on restart - a real rate limit belongs at your reverse proxy. 0 disables.
# AUTH_PASSWORD_RESET_MAX_REQUESTS_PER_IP_PER_HOUR=20
#
# The front-end URL a reset link points at; the token is appended as
# ?token=... Nothing about a token's validity depends on this. The default
# is the local `next dev` origin, so SET THIS on any real deployment or
# every emailed link will point at someone's laptop.
# AUTH_PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password

# --- Transactional email vendor (Phase 46 / D063) ---
# Optional. All three must be set together or no vendor is wired at all.
# Absent (the default), password resets still work end to end: a real token
# is created and an admin holding admin:manage reads the link out of
# POST /admin/users/{id}/password-reset and relays it by hand. What never
# happens is the app reporting an email as sent when nothing sent one.
#
# Deliberately vendor-name-agnostic. The wire contract is a generic
# transactional-email HTTP API - POST {base}/emails, bearer auth, JSON
# {"from", "to": [...], "subject", "text"}, any 2xx meaning accepted -
# which is Resend's shape; see
# apps/api/app/notifications/transactional_email.py. Any other vendor
# implements the EmailProvider Protocol instead of loosening this.
# Never commit real values here.
# EMAIL_PROVIDER_BASE_URL=https://api.resend.com
# EMAIL_PROVIDER_API_KEY=
# EMAIL_PROVIDER_FROM_ADDRESS=

# --- Automatic portfolio snapshots (Phase 27 / D030) ---
# OFF by default, deliberately. When true, an in-process background task
# writes a real portfolio snapshot row per eligible broker on an interval,
# unattended - so it is opt-in, like every other consequential switch here.
# Marks come from the configured market data vendor above; if a real quote
# can't be obtained for a held symbol, that broker is SKIPPED for the cycle
# and the skip is logged - never valued with a substituted price.
# Leave this false and Phase 25's manual POST /brokers/{id}/portfolio/snapshots
# stays the only capture path.
PORTFOLIO_SNAPSHOT_SCHEDULER_ENABLED=false
# Seconds between cycles (must be positive; the app refuses to start otherwise).
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=3600

# --- Broker credentials (PAPER/RESEARCH fixtures only — see §51) ---
# LIVE credentials must never be placed in this file or committed anywhere.
# BROKER_PAPER_API_KEY=
# BROKER_PAPER_API_SECRET=

# --- Market data vendor: Longbridge (D008/D015) ---
# Optional. All three must be set together or no vendor is wired at all
# (GET /market-data/{symbol}/quote returns 503 NOT_CONFIGURED, never a
# fabricated quote). These are read-only quote-API credentials, not
# trading credentials - get them from https://open.longportapp.com.
# Never commit real values here. The same three vars also gate the
# historical-price provider (D021) that feeds real SMA/RSI values to
# TechnicalAnalyst - no separate credentials needed.
# LONGPORT_APP_KEY=
# LONGPORT_APP_SECRET=
# LONGPORT_ACCESS_TOKEN=

# --- LIVE trading via Longbridge (Phase 43 / D058) ---
# REAL MONEY. Leave every one of these commented out unless you have
# deliberately decided, in that moment, to enable live trading.
#
# The live path only exists when ALL of the following are true together:
#   TRADING_MODE=live, LIVE_TRADING_ENABLED=true, and all three
#   LONGPORT_LIVE_* values set. Any one missing and no trade context is
#   constructed at all - POST /brokers/{id}/trades answers a live-broker
#   request with 400 NOT_CONFIGURED and never falls back to the simulator.
#
# These are TRADING credentials and are deliberately separate from the
# read-only LONGPORT_* quote credentials above; do not reuse one for the
# other. Never commit real values - keep them in a local, gitignored .env.
#
# Even fully configured, each live order additionally requires the
# trade:submit:live permission AND "confirm": true in that request's body,
# and is still gated by the emergency stop, the Risk Engine (at the tighter
# LIVE_RISK_* limits below), and the Portfolio Manager.
# LONGPORT_LIVE_APP_KEY=
# LONGPORT_LIVE_APP_SECRET=
# LONGPORT_LIVE_ACCESS_TOKEN=

# Which currency's cash balance on the live account counts as its cash.
# A missing balance in this currency fails the trade rather than being
# substituted from another currency at an unknown rate.
# LIVE_ACCOUNT_CURRENCY=USD

# Risk limits applied to LIVE trades only - kept separate from the RISK_*
# limits so paper behaviour is unaffected. Tighter on purpose: 5% of equity
# per position and 20% total exposure (vs paper's 10%/50%); per-trade risk
# stays at 1%.
# LIVE_RISK_MAX_POSITION_PCT_OF_EQUITY=0.05
# LIVE_RISK_MAX_PORTFOLIO_EXPOSURE_PCT_OF_EQUITY=0.20
# LIVE_RISK_MAX_RISK_PCT_OF_EQUITY_PER_TRADE=0.01

# --- Agent/LLM provider (D018) ---
# Optional. All three must be set together or no agent is wired at all
# (POST /brokers/{broker_id}/agent-trades returns 400 NOT_CONFIGURED,
# never a fabricated trade idea). Any endpoint speaking the Anthropic
# Messages API (POST {base}/v1/messages, bearer auth) works here -
# OmniRoute included. Never commit real values here.
# LLM_PROVIDER_BASE_URL=http://127.0.0.1:20128
# LLM_PROVIDER_API_KEY=
# LLM_PROVIDER_MODEL=
