# Copy to .env for local development. Never commit a real .env file.

# --- Execution mode gating (spec §3 / §46 / §56) ---
# research  = analysis only, no orders can be placed
# paper     = simulated broker, no real money
# live      = real broker, real money — requires LIVE_TRADING_ENABLED=true AND explicit confirmation flow
TRADING_MODE=research
LIVE_TRADING_ENABLED=false

# --- Emergency stop (spec Sec46 / D039) ---
# BOOTSTRAP DEFAULT ONLY. The authoritative kill-switch state lives in the
# emergency_stop_events table and is flipped live over
# POST /admin/emergency-stop (admin:manage, reason required) - no restart,
# no edit to this file. This value is consulted if and only if that table
# is still empty, i.e. the stop has never been flipped on this database;
# after that, changing it here has no effect on the trade path.
EMERGENCY_STOP_ACTIVE=false

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trading_os:trading_os@localhost:5432/trading_os
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Auth ---
# No default is provided in code on purpose - the app refuses to start
# without this set. Generate your own for local dev, never reuse this one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-CHANGE-ME-8f3a1c9e2b7d4f6091a5e8c2d7b4f1a9
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Automatic portfolio snapshots (Phase 27 / D030) ---
# OFF by default, deliberately. When true, an in-process background task
# writes a real portfolio snapshot row per eligible broker on an interval,
# unattended - so it is opt-in, like every other consequential switch here.
# Marks come from the configured market data vendor above; if a real quote
# can't be obtained for a held symbol, that broker is SKIPPED for the cycle
# and the skip is logged - never valued with a substituted price.
# Leave this false and Phase 25's manual POST /brokers/{id}/portfolio/snapshots
# stays the only capture path.
PORTFOLIO_SNAPSHOT_SCHEDULER_ENABLED=false
# Seconds between cycles (must be positive; the app refuses to start otherwise).
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=3600

# --- Broker credentials (PAPER/RESEARCH fixtures only — see §51) ---
# LIVE credentials must never be placed in this file or committed anywhere.
# BROKER_PAPER_API_KEY=
# BROKER_PAPER_API_SECRET=

# --- Market data vendor: Longbridge (D008/D015) ---
# Optional. All three must be set together or no vendor is wired at all
# (GET /market-data/{symbol}/quote returns 503 NOT_CONFIGURED, never a
# fabricated quote). These are read-only quote-API credentials, not
# trading credentials - get them from https://open.longportapp.com.
# Never commit real values here. The same three vars also gate the
# historical-price provider (D021) that feeds real SMA/RSI values to
# TechnicalAnalyst - no separate credentials needed.
# LONGPORT_APP_KEY=
# LONGPORT_APP_SECRET=
# LONGPORT_ACCESS_TOKEN=

# --- Agent/LLM provider (D018) ---
# Optional. All three must be set together or no agent is wired at all
# (POST /brokers/{broker_id}/agent-trades returns 400 NOT_CONFIGURED,
# never a fabricated trade idea). Any endpoint speaking the Anthropic
# Messages API (POST {base}/v1/messages, bearer auth) works here -
# OmniRoute included. Never commit real values here.
# LLM_PROVIDER_BASE_URL=http://127.0.0.1:20128
# LLM_PROVIDER_API_KEY=
# LLM_PROVIDER_MODEL=
