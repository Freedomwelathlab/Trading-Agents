# Copy to bridge_agent\.env on the PC that runs the gateway(s) and fill in.
# This file is gitignored as .env; never commit the real one.

# The Trading OS API (the Railway URL, not the web app). https:// is required
# unless it points at this machine.
PLATFORM_URL=https://your-api.up.railway.app

# The SAME value as BRIDGE_AGENT_TOKEN on the platform. At least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BRIDGE_AGENT_TOKEN=

# Which gateways this PC serves: ibkr, moomoo, or ibkr,moomoo
BRIDGE_PROVIDERS=ibkr
# Optional name shown on the platform's /bridge/status (default: this PC's hostname)
# BRIDGE_AGENT_ID=home-pc

# --- IBKR Client Portal Gateway -------------------------------------------
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
# Pin the agent to one account: jobs for any other account are refused.
# Use the same value as IBKR_ACCOUNT_ID on the platform. DUxxxxxxx = paper.
IBKR_ACCOUNT_ID=

# --- moomoo OpenD ------------------------------------------------------------
# MOOMOO_OPEND_HOST=127.0.0.1
# MOOMOO_OPEND_PORT=11111
# MOOMOO_ACCOUNT_ID=
# FUTUINC (moomoo US), FUTUSG (moomoo SG), FUTUAU, FUTUCA, FUTUJP, FUTUSECURITIES (HK)
# MOOMOO_SECURITY_FIRM=FUTUINC
# Only needed to unlock REAL trading for a real order. Stays on this PC.
# MOOMOO_TRADE_PASSWORD=

# --- tuning (defaults shown) ---------------------------------------------------
# BRIDGE_HEARTBEAT_SECONDS=15
# IBKR_TICKLE_SECONDS=60
# BRIDGE_CLAIM_WAIT_SECONDS=20
# BRIDGE_ORDER_MIN_SECONDS_LEFT=8
# BRIDGE_AGENT_LOG_FILE=bridge_agent.log
